# Style Bridge - server-side settings. The site runs without any of them, but live personalized search
# ("Your picks"), the where-to-buy comparison and AI photo analysis need OPENAI_API_KEY.
# No real key is included in this repository. Copy this file to .env (git-ignored) and add your own key.
# Keys are read only by server/api.ps1; they are never sent to the browser or printed in logs.

# --- Optional: personalized web search for brands and products (OpenAI Responses API + web_search) ---
# Placeholder only. Put your real key in .env (git-ignored) or an environment variable - never in browser code.
OPENAI_API_KEY=
# gpt-5.4-mini fits new accounts' per-minute limits; larger models (e.g. gpt-5.5) need a higher usage tier.
OPENAI_MODEL=gpt-5.4-mini
WEB_SEARCH_DAILY_LIMIT=100
# How much page text the search pulls in (low | medium | high) and the answer's token cap.
# Keep these low on new OpenAI accounts with small per-minute token limits.
WEB_SEARCH_CONTEXT=low
WEB_SEARCH_MAX_OUTPUT_TOKENS=9000
# Max web searches the model may run per request (each one adds page text = tokens and cost).
WEB_SEARCH_MAX_CALLS=6

# --- Optional: AI clothing analysis for outfit photos ---
# Uses Anthropic if ANTHROPIC_API_KEY is set; otherwise falls back to OPENAI_API_KEY (same model as web search).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
VISION_DAILY_LIMIT=50
MAX_IMAGE_MB=5

# --- Optional: nearby store lookup (Google Places API, "Text Search (New)") ---
PLACES_API_KEY=
PLACES_DAILY_LIMIT=200
STORE_CACHE_HOURS=24

# --- Product listings ---
# Default "manual-verified" serves hand-checked listings from data/products.json (no key needed).
# Live products/prices need an authorized feed (brand API, retailer feed, affiliate network);
# implement it in server/api.ps1 (Invoke-Products) before changing this value.
PRODUCT_FEED_PROVIDER=manual-verified
# PRODUCT_FEED_API_KEY=
